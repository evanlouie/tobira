{
  "name": "tobira",
  "version": "1.3.0",
  "private": true,
  "description": "Kagi CLI using a session-token client with optional MCP server mode",
  "keywords": [
    "cli",
    "claude",
    "kagi",
    "mcp",
    "search",
    "summarizer"
  ],
  "homepage": "https://github.com/evanlouie/tobira#readme",
  "bugs": {
    "url": "https://github.com/evanlouie/tobira/issues"
  },
  "license": "MIT",
  "author": "Carlo Zottmann <carlo@zottmann.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evanlouie/tobira.git"
  },
  "bin": {
    "tobira": "src/index.ts"
  },
  "files": [
    "src/",
    "package.json",
    "README.md",
    "LICENSE.md"
  ],
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun src/index.ts --help",
    "dev": "bun --inspect src/index.ts --help",
    "mcp": "bun src/index.ts mcp",
    "test:integration": "KAGI_INTEGRATION=1 bun test tests/integration",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --type-check src/ tests/",
    "fmt": "oxfmt src/ tests/",
    "prepare": "effect-tsgo patch --oxlint"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.4",
    "css-select": "^7.0.0",
    "domhandler": "^6.0.1",
    "effect": "4.0.4",
    "htmlparser2": "^12.0.0"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.52.0",
    "@types/bun": "^1.4.3",
    "oxfmt": "^0.73.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {}
}
